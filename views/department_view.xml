<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hms_department_list" model="ir.ui.view">
        <field name="name">hms.department.list</field>
        <field name="model">hms.department</field>
        <field name="arch" type="xml">
            <list string="Departments">
                <field name="name"/>
                <field name="capacity"/>
                <field name="is_opened"/>
            </list>
        </field>
    </record>

    <record id="view_hms_department_form" model="ir.ui.view">
        <field name="name">hms.department.form</field>
        <field name="model">hms.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Department Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Cardiology"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Department Rules">
                            <field name="capacity"/>
                            <field name="is_opened"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Current Patients">
                            <field name="patient_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hms_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hms.department</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>