<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_school_management">
            <field name="name">School Management</field>
            <field name="sequence">20</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_school_management">
            <field name="name">School Management Privilege</field>
            <field name="category_id" ref="module_category_school_management"/>
        </record>

        <record id="group_user_school_management" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_school_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/> 
        </record>

        <record id="group_manager_school_management" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_school_management"/>
            <field name="implied_ids" eval="[(4, ref('hms.group_user_school_management'))]"/>
        </record>

        <record id="hms_patient_rule_user" model="ir.rule">
            <field name="name">HMS Patient Rule User</field>
            <field name="model_id" ref="model_hms_patient"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('create_uid', '=', False)]</field>
            <field name="groups" eval="[(4, ref('hms.group_user_school_management'))]"/>
        </record>

        <record id="hms_patient_rule_manager" model="ir.rule">
            <field name="name">HMS Patient Rule Manager</field>
            <field name="model_id" ref="model_hms_patient"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hms.group_manager_school_management'))]"/>
        </record>
    </data>
</odoo>