<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_patient_status" model="ir.actions.report">
        <field name="name">Patient Status Report</field>
        <field name="model">hms.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hms.report_patient_status_template</field>
        <field name="report_file">hms.report_patient_status_template</field>
        <field name="binding_model_id" ref="model_hms_patient"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_patient_status_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>Patient Status Report</h2>
                        </div>
                        
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Name: </strong> <span t-field="doc.full_name"/><br/>
                                <strong>Birth date: </strong> <span t-field="doc.birth_date"/><br/>
                                <strong>Age: </strong> <span t-field="doc.age"/><br/>
                                <strong>Blood Type: </strong> <span t-field="doc.blood_type"/><br/>
                            </div>
                            <div class="col-6">
                                <strong>Email: </strong> <span t-field="doc.email"/><br/>
                                <strong>PCR: </strong> <span t-field="doc.cr_ratio"/><br/> 
                                <strong>Department: </strong> <span t-field="doc.department_id.name"/><br/>
                                <strong>Doctors: </strong> 
                                <span t-esc="', '.join([d.name for d in doc.doctor_ids])"/>
                            </div>
                        </div>

                        <hr/>

                        <h4 class="mt-4">Log History</h4>
                        <table class="table table-sm table-striped mt-2">
                            <thead style="border-bottom: 2px solid black;">
                                
                                <tr>
                                    <th>Date</th>
                                    <th>User</th>
                                    <th>Info</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.log_ids" t-as="log">
                                    <tr>
                                        <td><span t-field="log.date"/></td>
                                        <td><span t-field="log.created_by.name"/></td>
                                        <td><span t-field="log.description"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>